# Copy to .env (or export in your shell) to override defaults.
# The server reads these from process.env; it does not load .env files itself.

# HTTP + WebSocket port (default: 3000)
PORT=3000

# "development" (default) serves public/index.dev.html with separate modules.
# "production" / "prod" serves the minified bundle (run `npm run build:client` first,
# or use `npm run start:prod`, which builds and sets this for you).
APP_MODE=development
